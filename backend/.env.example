// Variables de entorno del backend de la Prueba de Conexión.
// Copia este archivo como `.env` y completa los valores.
// NUNCA subas `.env` a GitHub o a cualquier repositorio público.

# Puerto en el que escucha Node (PM2/nginx redirigirán aquí).
PORT=3000

# Cadena de conexión de MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/tneder_visits

# Origen permitido de CORS: tu dominio de GitHub Pages SIN barra final.
# Ejemplos:
#   https://tuusuario.github.io
#   https://tuusuario.github.io/tu-pagina   (si publicas en una subruta)
GITHUB_PAGES_ORIGIN=https://tuusuario.github.io

# Nivel de confianza en proxies inversos (nginx). Valores habituales:
#   1    -> un solo proxy (recomendado para este proyecto)
#   true -> confía en todo (solo si tienes infraestructura controlada)
TRUST_PROXY=1

# Límite de peticiones POST por IP en la ventana indicada.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Tamaño máximo (bytes) aceptado por body _. 16kb es suficiente.
BODY_LIMIT=16384